# ── Frontend (exposed to the browser — safe, anon-level only) ──────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe payment link for Peace of Mind (£9.99/month)
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
# Stripe customer billing portal (used by the "manage or cancel" footer link)
VITE_STRIPE_PORTAL_LINK=https://billing.stripe.com/p/login/...

# Cal.com booking used by the inline calendar on /session.
# MUST be "username/event-slug" — a bare username lands people on a list of
# event types with no payment attached, which is the old bug.
VITE_SESSION_CAL_LINK=kieran-rowan-tiujdp/60-minute-ai-scam-safety-session

# ── Serverless functions (Vercel → Settings → Environment Variables) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ── Email (Resend) ─────────────────────────────────────────────────────
# The domain secondlookprotect.co.uk must be verified in Resend before any
# of this sends. Receiving stays with Google — Resend only adds sending records.
RESEND_API_KEY=re_...
EMAIL_FROM="Second Look Protect <hello@secondlookprotect.co.uk>"
SUPPORT_EMAIL=hello@secondlookprotect.co.uk
ADMIN_NOTIFY_EMAIL=hello@secondlookprotect.co.uk
# Optional — split group-talk enquiries into their own inbox later
# TALKS_NOTIFY_EMAIL=talks@secondlookprotect.co.uk

# Public site URL, used to build links inside emails and WhatsApp pings
SITE_URL=https://second-look-protect.vercel.app
SUPPORT_PHONE=07563 887804

# ── WhatsApp pings to Kieran via CallMeBot (free) ─────────────────────
CALLMEBOT_PHONE=447563887804
CALLMEBOT_APIKEY=...

# ── Chase reminders (30 / 60 / 90 minutes) ────────────────────────────
# Any random string. Vercel cron sends it as a Bearer token automatically.
CRON_SECRET=make-up-a-long-random-string

# ── SMS to customers via The SMS Works (optional) ─────────────────────
SMSWORKS_JWT=...
SMS_SENDER=SecondLook

# ── Stripe subscription (£9.99/month Peace of Mind) ───────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
